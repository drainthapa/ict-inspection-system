# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=ict_inspection
PGUSER=ict
PGPASSWORD=change-me
PG_POOL_MAX=10
# Set to "true" when the database requires TLS (most managed hosts)
PGSSL=false

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---------- Initial Super Admin (used once by `npm run setup:admin`) ----------
# Remove ADMIN_PASSWORD from this file after the account is created.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------- Single-app hosting (cPanel) ----------
# Path to the built website (client/dist). When set, this server also serves the website.
# Leave empty when Nginx serves the website separately.
CLIENT_DIST=
